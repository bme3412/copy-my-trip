# Copy to .env.local and fill in. Without a token the archive renders its
# schematic fallback map instead of Mapbox.
VITE_MAPBOX_TOKEN=

# Optional CloudFront origin for production media. Leave blank in local
# development to serve app/public/media at /media/<city>/<file>.
VITE_MEDIA_BASE_URL=

# Server-side only (Vercel env / `vercel dev`) — powers /api/extract-preferences.
# NEVER prefix with VITE_ (that would bundle the key into the client).
ANTHROPIC_API_KEY=

# Internal CLI curator pilot only. This is never read by the browser/Vite app.
# Agents API key scopes: api.agents.read, api.agents.write, api.responses.write.
OPENAI_API_KEY=

# Optional accounts and cloud save. Public project URL and NEW publishable key only.
# No service-role or sb_secret key is needed anywhere in this milestone.
# Leave blank to retain the local-only app. Apply supabase/migrations first.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server may use the same public settings above, or these explicit equivalents.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Enable only after configuring and testing real signup/recovery email delivery.
VITE_ACCOUNT_EMAIL_READY=false

# Optional paid AI remains disabled pending public usage controls.
VITE_AI_ENABLED=false
AI_ENABLED=false

# Itinerary mail (server only). Keep false until the explicit self-recipient pilot passes.
COMPANION_EMAIL_ENABLED=false
# COMPANION_APP_ORIGIN=https://copy-my-trip.com
# CMT_MAIL_WORKER_SECRET=<random capability matching the database SHA-256 hash>
# CRON_SECRET=<separate random cron capability>
# RESEND_API_KEY=<sending-only key restricted to mail.copy-my-trip.com>
# RESEND_WEBHOOK_SECRET=<signing secret for the itinerary event endpoint>

# Weather in itinerary mail (server only). No email-triggered provider/cache calls
# while this flag is false; the explicit local evaluation preview is separate.
WEATHER_EMAIL_ENABLED=false
WEATHER_PROVIDER_MODE=disabled
# OPEN_METEO_API_KEY=<commercial customer API key; never VITE_>
# Evaluation mode is local-only, set explicitly when starting the Vite preview.
# Enable production weather only after migration 004, cache control, commercial
# access, and the hosted delivery/fallback checks have been approved and verified.
